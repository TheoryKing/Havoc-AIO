import { db } from '../main/db';

/** Per-site success curve: retry sooner where the site is generous, later where it punishes. */
export function nextDelay(site: string, attempt: number, base: number) {
  const row = db.prepare(
    `SELECT SUM(ok) ok, COUNT(*) n FROM (SELECT site, 1 ok FROM checkouts WHERE site=?
       UNION ALL SELECT site, 0 FROM logs WHERE site=? AND level='error' AND msg LIKE '%fail%' LIMIT 500)`
  ).get(site, site) as any;
  const rate = row?.n ? row.ok / row.n : 0.5;
  const curve = rate > 0.6 ? 1.3 : rate > 0.3 ? 2.0 : 3.2;
  return Math.round(base * Math.pow(curve, attempt) * (0.8 + Math.random() * 0.4));
}
