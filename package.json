{
  "name": "havoc-aio",
  "version": "1.0.0",
  "description": "Multi-site checkout automation client",
  "author": "TheoryKing",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -w -p tsconfig.main.json\" \"wait-on dist/main/index.js && electron .\"",
    "build": "vite build && tsc -p tsconfig.main.json",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^11.5.0",
    "cheerio": "^1.0.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.1",
    "node-tls-client": "^1.1.4",
    "playwright": "^1.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "electron": "^42.11.16",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.havoc.aio",
    "productName": "Havoc AIO",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/node-tls-client/**"
    ],
    "files": [
      "dist/**",
      "renderer/dist/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "HavocAIO-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/TheoryKing/Havoc-AIO/releases/latest/download"
      }
    ]
  },
  "overrides": {
    "minimatch@^10.2.5": "^11.0.5",
    "@electron/universal": "^3.0.6",
    "glob@^13.0.2": "^14.0.4"
  }
}
